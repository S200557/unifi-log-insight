# Copy to a private path outside the checkout and replace these two values.
POSTGRES_PASSWORD=replace-with-a-random-database-password
SECRET_KEY=replace-with-a-random-application-key
AUTH_ENABLED=true
HTTP_BIND=127.0.0.1
HTTP_PORT=8091
SYSLOG_BIND=127.0.0.1
SYSLOG_PORT=1515
TZ=Asia/Riyadh
RETENTION_DAYS=14
DNS_RETENTION_DAYS=14
RDNS_ENABLED=false
INGESTION_MODE=live
# Optional local GeoIP database downloads and remote threat scoring:
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=
# ABUSEIPDB_API_KEY=
# External PostgreSQL is optional; embedded PostgreSQL is the default.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=unifi_logs
# DB_USER=unifi
# DB_PASSWORD=
# DB_SSLMODE=require
